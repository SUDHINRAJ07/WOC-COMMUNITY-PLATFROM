# WOC Frontend Environment Configuration

# Backend API base URL.
# Local development default: http://127.0.0.1:8317/api
# Production deployment: https://api.yourdomain.com/api or /api (when served behind reverse proxy)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8317/api

# Explicit Demo Mode (default: false)
# When set to true, enables browser-only demo mode with localStorage.
# Leave false (or unset) to use the real Django database for all features.
NEXT_PUBLIC_DEMO_MODE=false

# Firebase Web app configuration (public; set before building the static frontend).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=woc-29231
NEXT_PUBLIC_FIREBASE_APP_ID=
