DEBUG=true
# Simple email/password signup; email ownership is not marked verified.
EMAIL_VERIFICATION_REQUIRED=false
# LOCALHOST DEVELOPMENT ONLY: display random OTP on screen, never send SMS.
WOC_LOCAL_SCREEN_OTP=true
DJANGO_SECRET_KEY=replace-with-a-random-private-key-before-production
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:4317
# CORS and CSRF Configuration for multi-device, staging, and production
# CORS_ALLOWED_ORIGINS=http://localhost:4317,http://127.0.0.1:4317,https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=http://localhost:4317,http://127.0.0.1:4317,https://yourdomain.com
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false
# Set all PostgreSQL values to use PostgreSQL instead of the local SQLite fallback.
# POSTGRES_DB=woc
# POSTGRES_USER=woc
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Email Service Configuration (Defaults to console backend for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=THE WOC <noreply@woc.org>
# For production transactional SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Brevo (Sendinblue): EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_HOST_USER=your-login, EMAIL_HOST_PASSWORD=master-key
# SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_PORT=587, EMAIL_HOST_USER=apikey, EMAIL_HOST_PASSWORD=SG.xxx
# Resend: EMAIL_HOST=smtp.resend.com, EMAIL_PORT=587, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=re_xxx
# Amazon SES: EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com, EMAIL_PORT=587, EMAIL_HOST_USER=xxx, EMAIL_HOST_PASSWORD=xxx
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-api-key
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10

# SMS Provider Configuration (NinzaSMS live mode; credentials required)
SMS_PROVIDER=ninzasms
SMS_TEST_MODE=false
NINZASMS_API_KEY=your_ninzasms_api_key
NINZASMS_SENDER_ID=16402
NINZASMS_API_URL=https://ninzasms.in.net/auth/send_sms.php
SMS_DEV_MODE=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# For Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# For MSG91 (India DLT):
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=WOCIND
# MSG91_TEMPLATE_ID=your_dlt_template_id

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4317/verify/?google_callback=true

# Firebase Admin: use Application Default Credentials or a private service-account file.
FIREBASE_PROJECT_ID=woc-29231
# Absolute path outside the repository; never put the JSON/private key in the frontend.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/woc-firebase-admin.json

# Require email OTP for NEW email/password signups; existing accounts unchanged.
EMAIL_SIGNUP_OTP_REQUIRED=false
# Gmail SMTP example (set actual credentials only in private server environment):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-sender@gmail.com
# EMAIL_HOST_PASSWORD=your-private-app-password
# DEFAULT_FROM_EMAIL=WOC - Wind of Change <your-sender@gmail.com>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
